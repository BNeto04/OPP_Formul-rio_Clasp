# ==============================================================================
# SYNTHEON AGENTIC LAYER - ENVIRONMENT CONFIGURATION TEMPLATE
# SPRINT: #68 SPRINT-A01-MULTIPROVIDER-FALLBACKS-001
# CARD: #103 / #92 HERMES-CLOUD-PROVIDERS-001 (DeepSeek direto sem Ollama)
# 
# INSTRUCOES DE SEGURANCA:
# 1. NUNCA faca commit de arquivos com chaves reais (.env, .env.local).
# 2. Copie este arquivo para .env localmente: cp .env.example .env
# 3. Insira as credenciais dos provedores autorizados pelo proprietario.
# ==============================================================================

# --- PROVEDOR PRIMARIO: DeepSeek Direct API ---
# Chave da API do DeepSeek
DEEPSEEK_API_KEY=
# Modelo padrao validado no Hermes para execucao comum
DEEPSEEK_MODEL=deepseek-v4-flash
# Modelo reservado para tarefas mais complexas quando custo/beneficio justificar
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# Base URL OpenAI-compatible
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Timeout em milissegundos (padrao: 45000)
DEEPSEEK_TIMEOUT_MS=45000

# --- PROVEDOR FALLBACK 1: Groq (toolsets escopados) ---
# Chave da API do Groq Cloud
GROQ_API_KEY=
# Modelo validado em smoke minimo; evitar payload completo do Hermes por limite 413
GROQ_MODEL=openai/gpt-oss-120b
# Base URL OpenAI-compatible
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Timeout em milissegundos (padrao: 20000)
GROQ_TIMEOUT_MS=20000

# --- PROVEDOR FALLBACK 2: Google Gemini (opcional; pode ficar limitado por quota) ---
# Chave da API do Google AI Studio / Gemini
GEMINI_API_KEY=
# Alias alternativo aceito por algumas bibliotecas Google
GOOGLE_API_KEY=
# Modelo padrao documentado; nao usar como primario enquanto houver quota/rate limit
GEMINI_MODEL=gemini-3.6-flash
# Timeout em milissegundos (padrao: 30000)
GEMINI_TIMEOUT_MS=30000

# --- PROVEDOR DIFERIDO: OpenRouter (Roteador Multi-modelo) ---
# Chave da API do OpenRouter
OPENROUTER_API_KEY=
# Modelo padrao de fallback de contingencia
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Base URL OpenAI-compatible
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Timeout em milissegundos (padrao: 45000)
OPENROUTER_TIMEOUT_MS=45000

# --- ROTEADOR E RESILIENCIA (CARD #71) ---
ROUTER_PRIMARY_PROVIDER=deepseek
ROUTER_FALLBACK_1_PROVIDER=groq
ROUTER_FALLBACK_2_PROVIDER=gemini
ROUTER_DEFERRED_PROVIDER=openrouter
ROUTER_MAX_RETRIES=2
ROUTER_RETRY_BACKOFF_MS=1000
