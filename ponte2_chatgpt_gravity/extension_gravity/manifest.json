{
  "manifest_version": 3,
  "name": "Syntheon Ponte 2 - Gravity Carrier",
  "version": "1.0.0",
  "description": "Extensão dedicada do lado Antigravity (Fase 2). Injeta CALLs no Antigravity e captura RESULTs.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8767/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Syntheon Ponte 2 - Gravity Carrier"
  }
}
