# ==============================================================================
# SYNTHEON AGENTIC LAYER - ENVIRONMENT CONFIGURATION TEMPLATE
# SPRINT: #68 SPRINT-A01-MULTIPROVIDER-FALLBACKS-001
# CARD: #70 T-A01-PROVIDERS-002 (AUDIT-FIX-001: Modelos Setembro/2026)
# 
# INSTRUCOES DE SEGURANCA:
# 1. NUNCA faca commit de arquivos com chaves reais (.env, .env.local).
# 2. Copie este arquivo para .env localmente: cp .env.example .env
# 3. Insira as credenciais dos provedores autorizados pelo proprietario.
# ==============================================================================

# --- PROVEDOR PRIMARIO: Google Gemini ---
# Chave da API do Google AI Studio / Gemini
GEMINI_API_KEY=
# Modelo padrao validado na documentacao oficial vigente (substituto de gemini-2.0-flash)
GEMINI_MODEL=gemini-3.6-flash
# Timeout em milissegundos (padrao: 30000)
GEMINI_TIMEOUT_MS=30000

# --- PROVEDOR FALLBACK 1: Groq (Ultra-baixa latencia) ---
# Chave da API do Groq Cloud
GROQ_API_KEY=
# Modelo padrao validado vigente para coding/tool use no Groq (substituto de llama-3.3-70b-versatile)
GROQ_MODEL=qwen/qwen3.6-27b
# Base URL OpenAI-compatible
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Timeout em milissegundos (padrao: 20000)
GROQ_TIMEOUT_MS=20000

# --- PROVEDOR FALLBACK 2: OpenRouter (Roteador Multi-modelo) ---
# Chave da API do OpenRouter
OPENROUTER_API_KEY=
# Modelo padrao de fallback de contingencia
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Base URL OpenAI-compatible
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Timeout em milissegundos (padrao: 45000)
OPENROUTER_TIMEOUT_MS=45000

# --- PROVEDOR OPCIONAL: DeepSeek (Direto) ---
# Chave da API do DeepSeek
DEEPSEEK_API_KEY=
# Modelo padrao validado vigente (substituto dos aliases descontinuados deepseek-chat/reasoner)
DEEPSEEK_MODEL=deepseek-v4-flash
# Base URL OpenAI-compatible
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Timeout em milissegundos (padrao: 45000)
DEEPSEEK_TIMEOUT_MS=45000

# --- PROVEDOR LOCAL DIAGNOSTICO: Hermes / Ollama (Offline / Legado) ---
# Base URL do endpoint local compativel com OpenAI
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Modelo local padrao
OLLAMA_MODEL=qwen2.5-coder:7b-64k
# Timeout em milissegundos (padrao: 60000)
OLLAMA_TIMEOUT_MS=60000

# --- ROTEADOR E RESILIENCIA (CARD #71) ---
ROUTER_PRIMARY_PROVIDER=gemini
ROUTER_FALLBACK_1_PROVIDER=groq
ROUTER_FALLBACK_2_PROVIDER=openrouter
ROUTER_MAX_RETRIES=2
ROUTER_RETRY_BACKOFF_MS=1000