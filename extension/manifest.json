{
  "manifest_version": 3,
  "name": "Syntheon Ponte 1 - Telegram ChatGPT",
  "version": "1.0.0",
  "description": "Ponte direta e exclusiva de transporte conversacional entre Telegram e ChatGPT (Fase 1).",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Syntheon Ponte 1"
  }
}
